{
  "name": "home-assistant",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "dev": "npm run build && firebase emulators:start --project demo-home-assistant --only functions,firestore",
    "refresh": "curl --fail --silent --show-error --request POST http://127.0.0.1:5001/demo-home-assistant/northamerica-northeast1/refreshWeather",
    "weather": "curl --fail --silent --show-error http://127.0.0.1:5001/demo-home-assistant/northamerica-northeast1/getWeather",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
